{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Levantar API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/ProgramasFacpya.Api/bin/Debug/net9.0/ProgramasFacpya.Api.dll",
            "cwd": "${workspaceFolder}/src/ProgramasFacpya.Api",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5165"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/scalar/v1"
            }
        }
    ]
}
